# Local PostgreSQL: start it with `docker compose up -d db`.
# The database, user, and password below match docker-compose.yml.
DATABASE_URL="postgresql://storefront:storefront_dev_password@localhost:5432/storefront?schema=public"

# Required by the idempotent development seed.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-long-unique-password"
SEED_CUSTOMER_PASSWORD="replace-with-a-different-long-unique-password"

# Generate a strong secret with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-with-a-generated-secret"

# Google OAuth credentials from Google Cloud Console.
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID="your-google-client-id"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# Supabase project URL and a publishable (or legacy anon) key only.
# Never put a Supabase secret/service-role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your-project-publishable-key"
